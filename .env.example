# New staging Apps Script web-app URL. Never use the legacy production endpoint here.
VITE_API_URL=

# Keep enabled until the new staging Apps Script deployment is connected.
VITE_DEMO_MODE=true

# Lets staging accept TEST-SK identifiers without enabling demo responses.
VITE_ENVIRONMENT=STAGING

# Optional staging GA4 property. Do not use the production property during local testing.
VITE_GA_MEASUREMENT_ID=

# Comma-separated email domains that can receive staging notifications.
VITE_STAGING_EMAIL_DOMAINS=mysktech.com
